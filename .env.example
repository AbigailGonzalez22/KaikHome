# Copiar este archivo a .env y completar con los datos reales del FTP.
# .env está en .gitignore — nunca se sube a git.

FTP_HOST=ftp.kaikhome.com
FTP_PORT=21
FTP_USER=usuario_ftp
FTP_PASS=CHANGE_ME
# Carpeta remota donde vive el sitio (la que ve el navegador en la raíz del dominio)
FTP_REMOTE_PATH=/
