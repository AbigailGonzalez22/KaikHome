---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

// Responsive AVIF/WebP with a JPEG fallback capped at the largest width we serve.
// Several source files are PNG data with a .jpg name; the fallback is always JPEG.
type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> & {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  quality?: number;
};
const { src, alt, widths, sizes, quality = 72, ...rest } = Astro.props;
const capped = widths.filter((w) => w <= src.width);
const list = capped.length ? capped : [src.width];
const max = Math.max(...list);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={list}
  width={max}
  height={Math.round((src.height / src.width) * max)}
  sizes={sizes}
  quality={quality}
  {...rest}
/>
