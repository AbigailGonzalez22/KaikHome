---
import Icon from './Icon.astro';
import { site, asuntos } from '../data/site';

interface Props {
  origen: string;
  titulo: string;
  texto: string;
  conAsunto?: boolean;
  mensajePlaceholder?: string;
  boton?: string;
}
const {
  origen,
  titulo,
  texto,
  conAsunto = false,
  mensajePlaceholder = 'Cuéntanos qué buscas o qué te gustaría saber',
  boton = 'Enviar mensaje',
} = Astro.props;
const id = (name: string) => `${name}-${origen}`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.address.street}, ${site.address.postalCode} ${site.address.locality}, ${site.address.region}`,
)}`;
---

<section class="section contact-section" id="contacto" aria-labelledby={id('contacto-titulo')}>
  <div class="container">
    <div class="contact-panel reveal">
      <div class="contact-info">
        <div>
          <h2 id={id('contacto-titulo')}>{titulo}</h2>
          <p>{texto}</p>
        </div>

        <ul class="contact-list">
          <li>
            <a class="contact-detail" href={site.phoneHref}>
              <span class="icon-circle"><Icon name="phone" size={18} /></span>
              <span>
                <span class="label">Teléfono</span>
                <span class="value">{site.phone}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="contact-detail" href={`mailto:${site.email}`}>
              <span class="icon-circle"><Icon name="mail" size={18} /></span>
              <span>
                <span class="label">Email</span>
                <span class="value">{site.email}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="contact-detail" href={mapsHref} target="_blank" rel="noopener">
              <span class="icon-circle"><Icon name="pin" size={18} /></span>
              <span>
                <span class="label">Oficina</span>
                <span class="value">{site.address.street}, {site.address.locality}</span>
                <span class="hint">Ver en el mapa</span>
              </span>
            </a>
          </li>
        </ul>

        <div class="call-box">
          <p>¿Prefieres hablar con nosotros?</p>
          <a class="btn btn-mint" href={site.phoneHref}><Icon name="phone" size={18} /> Llamar ahora</a>
        </div>
      </div>

      <div class="contact-form-wrap">
        <form class="contact-form" action="/contact.php" method="post" novalidate data-contact-form>
          <input type="hidden" name="origen" value={origen} />
          <div class="hp" aria-hidden="true">
            <label for={id('website')}>No completar este campo</label>
            <input type="text" id={id('website')} name="website" tabindex="-1" autocomplete="off" />
          </div>

          {
            conAsunto && (
              <fieldset class="topics">
                <legend>¿En qué podemos ayudarte?</legend>
                <div class="topic-list">
                  {asuntos.map((a, i) => (
                    <label class="topic">
                      <input type="radio" name="asunto" value={a.value} data-key={a.key} checked={i === 0} />
                      <span>{a.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }

          <div class="form-row">
            <div class="form-group">
              <label for={id('nombre')}>Nombre</label>
              <input type="text" id={id('nombre')} name="nombre" required minlength="2" autocomplete="name" placeholder="Tu nombre" />
              <p class="field-error" id={`${id('nombre')}-error`} hidden>Escribe tu nombre.</p>
            </div>
            <div class="form-group">
              <label for={id('telefono')}>Teléfono <span>(opcional)</span></label>
              <input type="tel" id={id('telefono')} name="telefono" autocomplete="tel" inputmode="tel" placeholder="600 000 000" />
            </div>
          </div>
          <div class="form-group">
            <label for={id('email')}>Email</label>
            <input type="email" id={id('email')} name="email" required autocomplete="email" inputmode="email" placeholder="tu@email.com" />
            <p class="field-error" id={`${id('email')}-error`} hidden>Escribe un email válido, por ejemplo nombre@correo.com.</p>
          </div>
          <div class="form-group">
            <label for={id('mensaje')}>Mensaje</label>
            <textarea id={id('mensaje')} name="mensaje" rows="4" required minlength="5" placeholder={mensajePlaceholder}></textarea>
            <p class="field-error" id={`${id('mensaje')}-error`} hidden>Cuéntanos en qué podemos ayudarte (mínimo 5 caracteres).</p>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <span class="spinner" aria-hidden="true"></span>
            <span data-label>{boton}</span>
            <Icon name="arrow" size={18} />
          </button>
          <p class="form-note">Solo usaremos tus datos para responder a tu consulta.</p>
          <p class="form-msg" role="alert" data-error></p>
        </form>

        <div class="form-success" hidden data-success tabindex="-1">
          <span class="success-icon"><Icon name="check" size={30} /></span>
          <h3>¡Mensaje enviado!</h3>
          <p data-success-text>Gracias, te contactaremos pronto.</p>
          <button type="button" class="btn btn-outline" data-reset>Enviar otro mensaje</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--paper-3);
  }

  .contact-panel {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-strong);
  }

  /* --- Dark info panel ---------------------------------------------------- */
  .contact-info {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 36px;
    background: var(--dark);
    color: #fff;
    padding: 56px 48px 48px;
  }

  /* Mint glow: rests in the top-right corner and follows the pointer while it is over the panel. */
  .contact-info::before {
    content: '';
    position: absolute;
    left: var(--gx, 85%);
    top: var(--gy, 12%);
    width: 460px;
    height: 460px;
    translate: -50% -50%;
    background: radial-gradient(circle, rgb(154 247 175 / 0.3) 0%, rgb(154 247 175 / 0) 68%);
    pointer-events: none;
  }

  .contact-info > * {
    position: relative;
  }

  .contact-info h2 {
    font-size: clamp(26px, 1.2rem + 1vw, 34px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .contact-info h2 + p {
    color: rgb(255 255 255 / 0.78);
    font-size: 16px;
    max-width: 40ch;
  }

  .contact-list {
    display: grid;
    gap: 8px;
  }

  .contact-detail {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 -14px;
    padding: 10px 14px;
    border-radius: 16px;
    transition: background-color 0.2s ease;
  }

  .contact-detail:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .contact-detail .icon-circle {
    width: 44px;
    height: 44px;
    background: rgb(154 247 175 / 0.14);
    color: var(--green-mint);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .contact-detail:hover .icon-circle {
    background: var(--green-mint);
    color: var(--ink);
  }

  .contact-detail .label {
    display: block;
    color: var(--green-mint);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .contact-detail .value {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
  }

  .contact-detail .hint {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: rgb(255 255 255 / 0.6);
  }

  .contact-detail:hover .hint {
    color: var(--green-mint);
  }

  .call-box {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 20px;
    padding: 20px 22px;
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  .call-box p {
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  .btn-mint {
    padding: 12px 20px;
    background: var(--green-mint);
    color: var(--ink);
  }

  .btn-mint:hover {
    background: #b6fbc6;
  }

  /* --- Form ---------------------------------------------------------------- */
  .contact-form-wrap {
    position: relative;
    background: #fff;
    padding: 56px 48px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .topics {
    margin: 0 0 24px;
    padding: 0;
    border: 0;
  }

  .topics legend {
    padding: 0;
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic {
    position: relative;
  }

  .topic input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .topic:hover span {
    border-color: var(--green-dark);
    color: var(--green-ink);
  }

  .topic input:checked + span {
    background: var(--green-btn);
    border-color: var(--green-btn);
    color: #fff;
  }

  .topic input:focus-visible + span {
    outline: 3px solid var(--green-dark);
    outline-offset: 2px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .form-group label span {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    border: 1px solid #d5dcd5;
    border-radius: 14px;
    background: var(--paper-3);
    color: var(--ink);
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #8a938b;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 128px;
  }

  .form-group input:hover,
  .form-group textarea:hover {
    border-color: #a9b6aa;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--green-dark);
    box-shadow: 0 0 0 4px rgb(85 143 110 / 0.16);
  }

  .form-group [aria-invalid='true'] {
    border-color: #c4543d;
    background: #fff;
    box-shadow: 0 0 0 4px rgb(226 114 91 / 0.14);
  }

  .field-error {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #b0432d;
  }

  .contact-form .btn-block {
    min-height: 54px;
    margin-top: 6px;
  }

  .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.4);
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
  }

  .is-sending .spinner {
    display: inline-block;
  }

  .is-sending .btn-block :global(svg) {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .form-note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--ink-soft);
    text-align: center;
  }

  .form-msg:empty {
    display: none;
  }

  .form-msg {
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgb(226 114 91 / 0.12);
    color: #a33f2a;
    font-size: 14px;
    font-weight: 600;
  }

  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    min-height: 100%;
    padding: 24px 0;
    outline: none;
    animation: success-in 0.5s var(--ease-smooth);
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .success-icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--green-mint);
    color: #1d5236;
  }

  .form-success h3 {
    font-size: 24px;
    font-weight: 800;
  }

  .form-success p {
    max-width: 34ch;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  @media (max-width: 1024px) {
    .contact-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contact-info,
    .contact-form-wrap {
      padding: 36px 22px;
    }

    .contact-info {
      gap: 28px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .call-box .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Glow follows the pointer with a soft lag, then eases back to its corner.
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.contact-info').forEach((panel) => {
    if (!finePointer || reducedMotion) return;
    const rest = { x: 0.85, y: 0.12 };
    const pos = { ...rest };
    const target = { ...rest };
    let raf = 0;
    const loop = () => {
      pos.x += (target.x - pos.x) * 0.12;
      pos.y += (target.y - pos.y) * 0.12;
      panel.style.setProperty('--gx', `${pos.x * 100}%`);
      panel.style.setProperty('--gy', `${pos.y * 100}%`);
      raf = Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.001 ? requestAnimationFrame(loop) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop);
    };
    panel.addEventListener('pointermove', (e) => {
      const r = panel.getBoundingClientRect();
      target.x = (e.clientX - r.left) / r.width;
      target.y = (e.clientY - r.top) / r.height;
      kick();
    });
    panel.addEventListener('pointerleave', () => {
      target.x = rest.x;
      target.y = rest.y;
      kick();
    });
  });

  // Preselect the subject from ?asunto=<key> or from a link with data-asunto-link.
  const selectTopic = (key: string | null | undefined) => {
    if (!key) return;
    const radio = document.querySelector<HTMLInputElement>(`input[name="asunto"][data-key="${CSS.escape(key)}"]`);
    if (radio) radio.checked = true;
  };
  selectTopic(new URLSearchParams(location.search).get('asunto'));
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-asunto-link]');
    if (link) selectTopic(link.dataset.asuntoLink);
  });

  const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = field.form?.querySelector<HTMLElement>(`#${field.id}-error`);
    const ok = field.checkValidity();
    field.setAttribute('aria-invalid', String(!ok));
    if (error) {
      error.hidden = ok;
      if (ok) field.removeAttribute('aria-describedby');
      else field.setAttribute('aria-describedby', error.id);
    }
    return ok;
  };

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const wrap = form.parentElement!;
    const success = wrap.querySelector<HTMLElement>('[data-success]')!;
    const successText = wrap.querySelector<HTMLElement>('[data-success-text]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector<HTMLElement>('[data-label]')!;
    const initialLabel = label.textContent ?? '';
    const required = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));

    required.forEach((field) => {
      field.addEventListener('blur', () => {
        if (field.value !== '') validate(field);
      });
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    wrap.querySelector('[data-reset]')?.addEventListener('click', () => {
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="nombre"]')?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = required.filter((field) => !validate(field));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      button.disabled = true;
      form.classList.add('is-sending');
      label.textContent = 'Enviando…';
      errorBox.textContent = '';

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await response.json();
        if (data.success) {
          successText.textContent = data.message || 'Gracias, te contactaremos pronto.';
          form.reset();
          form.hidden = true;
          success.hidden = false;
          success.focus();
          window.dataLayer?.push({
            event: 'form_submit_success',
            origen: (form.elements.namedItem('origen') as HTMLInputElement).value,
          });
        } else {
          errorBox.textContent = data.message || 'No se pudo enviar el mensaje. Inténtalo de nuevo o llámanos.';
        }
      } catch {
        errorBox.textContent = 'No se pudo enviar el mensaje. Comprueba tu conexión e inténtalo de nuevo, o llámanos.';
      } finally {
        button.disabled = false;
        form.classList.remove('is-sending');
        label.textContent = initialLabel;
      }
    });
  });

  declare global {
    interface Window {
      dataLayer?: Record<string, unknown>[];
    }
  }
</script>
