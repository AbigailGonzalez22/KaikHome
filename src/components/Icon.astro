---
// Line icons drawn on a 24 grid with the same 2px rounded stroke as the original site.
type IconName =
  | 'arrow'
  | 'down'
  | 'check'
  | 'chevron'
  | 'home'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'ubicacion'
  | 'menu'
  | 'close'
  | 'prev'
  | 'next'
  | 'plantas'
  | 'entrega'
  | 'obra'
  | 'viviendas'
  | 'clock'
  | 'plan'
  | 'facebook'
  | 'instagram';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<IconName, string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  down: '<path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  check: '<path d="M5 12l5 5 9-9"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  home: '<path d="M3 11l9-8 9 8"/><path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"/>',
  phone: '<path d="M22 16.92v3a1 1 0 0 1-1.1 1A19.8 19.8 0 0 1 2.08 4.1 1 1 0 0 1 3.08 3h3a1 1 0 0 1 1 .75c.13.96.36 1.9.7 2.8a1 1 0 0 1-.23 1.05L6.3 8.85a16 16 0 0 0 8.85 8.85l1.25-1.25a1 1 0 0 1 1.05-.23c.9.34 1.84.57 2.8.7a1 1 0 0 1 .75 1z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  pin: '<path d="M12 21s7-6.5 7-11.5a7 7 0 0 0-14 0C5 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  ubicacion: '<path d="M12 21s7-6.5 7-11.5a7 7 0 0 0-14 0C5 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  prev: '<path d="M15 6l-6 6 6 6"/>',
  next: '<path d="M9 6l6 6-6 6"/>',
  plantas: '<path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-4h6v4M9 11h6"/>',
  entrega: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>',
  obra: '<path d="M2 20h20M6 20V10l6-4 6 4v10"/><path d="M10 20v-5h4v5"/>',
  viviendas: '<path d="M3 10l6-5 6 5"/><path d="M5 9v11h8V9"/><path d="M15 12l3-2.5 3 2.5v8h-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  plan: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h8v9M11 3v5M15 12h6M15 12v4"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
};
---

<svg
  class:list={[name, cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
