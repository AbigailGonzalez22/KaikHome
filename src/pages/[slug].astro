---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import ContactSection from '../components/ContactSection.astro';
import PlanDialog from '../components/PlanDialog.astro';
import logo from '../assets/img/logo.png';
import type { Promo } from '../lib/promo';
import { site } from '../data/site';

export async function getStaticPaths() {
  const promociones = await getCollection('promociones');
  return promociones.map((promo) => ({ params: { slug: promo.id }, props: { promo } }));
}

interface Props {
  promo: Promo;
}
const { promo } = Astro.props;
const p = promo.data;
const og = await getImage({ src: p.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const single = p.tipologias.length === 1;

const pageUrl = `${site.url}/${promo.id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ApartmentComplex',
      '@id': `${pageUrl}#promocion`,
      name: p.nombre,
      description: p.descripcion,
      url: pageUrl,
      image: new URL(og.src, site.url).href,
      numberOfAccommodationUnits: p.viviendas,
      address: {
        '@type': 'PostalAddress',
        addressLocality: p.localidad,
        addressRegion: p.provincia,
        addressCountry: 'ES',
      },
      containsPlace: p.tipologias.map((t) => ({
        '@type': 'SingleFamilyResidence',
        name: t.nombre,
        numberOfBedrooms: t.dormitorios,
        numberOfBathroomsTotal: t.banos,
        floorSize: { '@type': 'QuantitativeValue', value: t.construidos, unitCode: 'MTK' },
      })),
      provider: {
        '@type': 'RealEstateAgent',
        '@id': `${site.url}/#organizacion`,
        name: site.name,
        url: `${site.url}/`,
        telephone: '+34687459216',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Promociones', item: `${site.url}/#promociones` },
        { '@type': 'ListItem', position: 3, name: p.localidad, item: pageUrl },
      ],
    },
  ],
};
---

<Base
  title={p.seo.title}
  description={p.seo.description}
  ogTitle={p.seo.ogTitle}
  ogDescription={p.seo.ogDescription}
  ogImage={og.src}
  jsonLd={jsonLd}
  active={promo.id}
>
  <!-- HERO -->
  <section class="hero-project">
    <div class="hero-bg" style={`view-transition-name: hero-${promo.id}`} data-parallax>
      <Img
        src={p.hero}
        alt={p.heroAlt}
        widths={[640, 960, 1440, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero-project-inner">
      <nav class="crumbs hero-in" style="--d: 0" aria-label="Estás en">
        <a href="/">Inicio</a>
        <Icon name="next" size={14} />
        <a href="/#promociones">Promociones</a>
        <Icon name="next" size={14} />
        <span aria-current="page">{p.localidad}</span>
      </nav>
      <span class="badge badge-white hero-badge hero-in" style="--d: 0">
        <span class:list={['badge-dot', `dot-${p.estadoColor}`]}></span>
        {p.viviendas} viviendas en {p.localidad}
        <span class="badge-sep" aria-hidden="true"></span>
        <span class:list={['badge-state', `state-${p.estadoColor}`]}>{p.estado}</span>
      </span>
      <h1 class="hero-in" style="--d: 1">{p.nombre}, {p.titular}</h1>
      <p class="hero-in" style="--d: 2">{p.descripcion}</p>

      <ul class="hero-stat-bar hero-in" style="--d: 3">
        {
          p.stats.map((s) => (
            <li class="hero-stat">
              <Icon name={s.icono} size={18} />
              {s.texto}
            </li>
          ))
        }
      </ul>

      <div class="hero-actions hero-in" style="--d: 4">
        <a href="#contacto" class="btn btn-primary">Reservar visita <Icon name="arrow" size={18} /></a>
        <a href={p.dossier} class="btn btn-ghost-white" download>
          <Icon name="down" size={18} /> Descargar dossier <small>PDF</small>
        </a>
      </div>
    </div>
  </section>

  <!-- TIPOLOGÍAS -->
  <section class="section tipologias-section" id="tipologias">
    <div class="container">
      <div class="section-head reveal">
        <h2>Tipologías disponibles</h2>
        <p>Encuentra la distribución que mejor se adapta a tu estilo de vida.</p>
      </div>

      <div class:list={['tipologias-grid', { 'tipologias-grid-single': single }]}>
        {
          p.tipologias.map((t, i) => (
            <article class="tipologia-card reveal" style={`--i: ${i}`}>
              <div class="tipologia-media">
                <Img
                  src={t.imagen}
                  alt={t.imagenAlt}
                  widths={[480, 720, 1100]}
                  sizes={single ? '(min-width: 1024px) 760px, 100vw' : '(min-width: 1024px) 570px, 100vw'}
                />
                <div class="tipologia-badges">
                  <span class="badge badge-white">{t.construidos} m² construidos</span>
                  <span class="badge badge-white">{t.patios} m² patios</span>
                </div>
              </div>
              <div class="tipologia-body">
                <h3>{t.nombre}</h3>
                <div class="tipologia-chips">
                  <span class="chip">{t.dormitorios} Dorm.</span>
                  <span class="chip">{t.banos} Baños</span>
                </div>
                <ul class="check-list">
                  {t.rasgos.map((r) => (
                    <li>
                      <Icon name="check" size={18} />
                      {r}
                    </li>
                  ))}
                </ul>
                <div class="tipologia-actions">
                  <button type="button" class="btn btn-outline" data-open-plan={`planos-${t.id}`}>
                    <Icon name="plan" size={18} /> Ver planos
                  </button>
                  <a
                    href="#contacto"
                    class="consult-link"
                    data-interes={`Hola, me interesa la ${t.nombre.toLowerCase()} de ${p.nombre}. ¿Podéis darme más información?`}
                  >
                    Consultar esta vivienda <Icon name="arrow" size={16} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {p.tipologias.map((t) => <PlanDialog id={`planos-${t.id}`} titulo={t.nombre} planos={t.planos} />)}

  <!-- FRANJA DE CONFIANZA -->
  <section class="trust-strip">
    <div class="container trust-item reveal">
      <span class="trust-label">Promueve y construye</span>
      <Image class="trust-logo" src={logo} alt="Kaik Home" width={200} height={54} />
    </div>
  </section>

  <ContactSection
    origen={promo.id}
    titulo={p.contacto.titulo}
    texto={p.contacto.texto}
    mensajePlaceholder={`¿Qué te gustaría saber sobre ${p.nombre}?`}
    boton="Enviar solicitud"
  />

  <a href="#contacto" class="fab" slot="after" data-fab>
    <Icon name="mail" size={18} /> Quiero más info
  </a>
</Base>

<style>
  /* HERO INTERIOR ----------------------------------------------------------- */
  .hero-project {
    position: relative;
    min-height: min(760px, calc(100svh - var(--head-h)));
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: #232b25;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ken-burns 14s ease-out both;
  }

  @keyframes ken-burns {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1.02);
    }
  }

  .hero-project::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.55) 50%, rgb(0 0 0 / 0.2) 100%);
  }

  .hero-project-inner {
    padding-top: 120px;
    padding-bottom: 64px;
  }

  .hero-project h1 {
    font-size: clamp(32px, 1.5rem + 2.6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 20px 0 18px;
    max-width: 820px;
  }

  .hero-project-inner > p {
    font-size: 17px;
    max-width: 620px;
    color: rgb(255 255 255 / 0.9);
    margin-bottom: 32px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
    color: rgb(255 255 255 / 0.8);
  }

  .crumbs a {
    transition: color 0.15s ease;
  }

  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current] {
    color: #fff;
  }

  .crumbs :global(svg) {
    opacity: 0.6;
  }

  .badge-sep {
    width: 1px;
    height: 14px;
    background: rgb(27 28 28 / 0.2);
  }

  .state-clay {
    color: var(--clay-btn);
  }

  .state-green {
    color: var(--green-ink);
  }

  .hero-actions small {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.75;
  }

  .hero-in {
    animation: rise-in 0.9s var(--ease-smooth) both;
    animation-delay: calc(var(--d) * 110ms + 150ms);
  }

  @keyframes rise-in {
    from {
      opacity: 0.4;
      transform: translateY(18px);
    }
  }

  .hero-stat-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 32px;
  }

  .hero-stat {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
  }

  .hero-stat :global(svg) {
    color: var(--green-mint);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* TIPOLOGÍAS -------------------------------------------------------------- */
  .tipologias-section {
    background: var(--paper);
  }

  .tipologias-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .tipologias-grid-single {
    grid-template-columns: 1fr;
    max-width: 760px;
    margin: 0 auto;
  }

  .tipologia-card {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
  }

  html.js .tipologia-card.reveal.is-visible {
    transition:
      opacity 0.8s var(--ease-smooth),
      transform 0.5s var(--ease-smooth),
      box-shadow 0.5s var(--ease-smooth);
  }

  .tipologia-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-strong);
  }

  .tipologia-media {
    position: relative;
    height: clamp(260px, 14rem + 6vw, 360px);
    background: #d7dcd8;
    overflow: hidden;
  }

  .tipologia-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-smooth);
  }

  .tipologia-card:hover .tipologia-media :global(img) {
    transform: scale(1.05);
  }

  .tipologia-badges {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tipologia-badges .badge {
    color: var(--green-ink);
  }

  .tipologia-body {
    padding: 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tipologia-body h3 {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 14px;
  }

  .tipologia-chips {
    display: flex;
    gap: 10px;
    margin-bottom: 6px;
  }

  .tipologia-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: auto;
  }

  .consult-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--green-ink);
  }

  .consult-link :global(svg) {
    transition: transform 0.3s var(--ease-smooth);
  }

  .consult-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .consult-link:hover :global(svg) {
    transform: translateX(3px);
  }

  /* FRANJA DE CONFIANZA ------------------------------------------------------ */
  .trust-strip {
    background: var(--paper-2);
    border-top: 1px solid rgb(27 28 28 / 0.06);
    border-bottom: 1px solid rgb(27 28 28 / 0.06);
    padding: 48px 0;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .trust-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .trust-item :global(.trust-logo) {
    height: 52px;
    width: auto;
  }

  /* FAB ---------------------------------------------------------------------- */
  .fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--dark);
    color: #fff;
    padding: 16px 22px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 14px;
    box-shadow: var(--shadow-strong);
    transform: translateY(120px);
    transition:
      transform 0.45s var(--ease-smooth),
      background-color 0.2s ease;
  }

  .fab.is-on {
    transform: none;
  }

  .fab.is-on:hover {
    transform: translateY(-2px);
    background: var(--green-btn);
  }

  @media (max-width: 1024px) {
    .tipologias-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .hero-stat-bar {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      padding: 20px 22px;
    }
  }

  @media (max-width: 640px) {
    .hero-project-inner {
      padding-bottom: 40px;
    }

    .hero-project-inner {
      padding-top: 72px;
    }

    .hero-project-inner > p {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .crumbs {
      font-size: 13px;
    }

    .fab {
      padding: 12px 16px;
      font-size: 13px;
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<script>
  // "Consultar esta vivienda" prefills the contact message when it is still empty.
  document.querySelectorAll<HTMLAnchorElement>('[data-interes]').forEach((link) => {
    link.addEventListener('click', () => {
      const field = document.querySelector<HTMLTextAreaElement>('#contacto textarea[name="mensaje"]');
      if (field && !field.value.trim()) field.value = link.dataset.interes!;
      setTimeout(() => document.querySelector<HTMLInputElement>('#contacto input[name="nombre"]')?.focus({ preventScroll: true }), 700);
    });
  });

  // The floating "Quiero más info" button appears after the hero and hides over the contact form.
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  const hero = document.querySelector<HTMLElement>('.hero-project');
  const contact = document.getElementById('contacto');
  if (fab && hero && contact) {
    let queued = false;
    const update = () => {
      queued = false;
      const pastHero = hero.getBoundingClientRect().bottom < 0;
      const c = contact.getBoundingClientRect();
      fab.classList.toggle('is-on', pastHero && !(c.top < innerHeight && c.bottom > 0));
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();
  }
</script>
